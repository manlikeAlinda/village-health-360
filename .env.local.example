NEXT_PUBLIC_API_URL=http://localhost:4000

# Local dev against the Firebase Auth emulator (see server/README.md).
# In production, set these instead: NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN,
# NEXT_PUBLIC_FIREBASE_PROJECT_ID, and drop NEXT_PUBLIC_USE_FIREBASE_EMULATOR.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=village-health-360-dev
