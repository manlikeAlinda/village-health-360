# Local development against the Firebase emulator suite:
#   1. run `npm run emulators` in one terminal (from server/)
#   2. copy this file to .env and set the two emulator host vars below
#   3. run `npm run dev` in another terminal
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=village-health-360-dev

# Production (pick ONE of these once you have a real Firebase project):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

PORT=4000
CORS_ORIGIN=http://localhost:3000
