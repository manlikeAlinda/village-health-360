rules_version = '2';

// All reads/writes go through the Express API (Firebase Admin SDK), which
// bypasses these rules entirely. This denies direct client-side access to
// Firestore until Phase 2 wires up Firebase Auth and per-collection rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
